# Phase IV — deploy-time secrets. PLACEHOLDER TEMPLATE ONLY.
#
#   cp deploy/.env.deploy.example deploy/.env.deploy
#   # then fill in the real values
#
# deploy/.env.deploy is gitignored and is never baked into an image. It is the
# ONLY place real credentials live on disk. deploy/deploy.sh turns it into the
# `todo-chatbot-secrets` Secret (FR-007, FR-008).
#
# Every key below is referenced by a Deployment with `optional: false`, so a
# missing or misspelled key makes the pod fail to start and NAME the item
# (FR-010 / SC-008) rather than starting half-configured.

# Neon PostgreSQL. ONE URL serves both services: the backend rewrites the
# driver prefix and ssl flag in settings.py, the frontend's pg.Pool consumes it
# as-is. Use the pooled (-pooler) endpoint. The Phase IV deployment targets the
# EXISTING database on the `main` branch — see specs/.../research.md §3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth session/JWT signing secret. Used by BOTH services.
BETTER_AUTH_SECRET=replace_with_a_long_random_string

# The chatbot's model provider credential. Read at backend-api/src/agents/agent_config.py:80
# (COHERE_API_KEY — note the stale .env.example names GEMINI_API_KEY, which is unused).
COHERE_API_KEY=replace_with_your_cohere_key
